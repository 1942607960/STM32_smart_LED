{
    "configurations": [
        {
            "name": "STM32",
            "includePath": [
                "${workspaceFolder}/Libraries/CMSIS/**",
                "${workspaceFolder}/Libraries/STM32F10x_StdPeriph_Driver/inc/**",
                "${workspaceFolder}/User/**",
                "${workspaceFolder}/Gizwits/**",
                "${workspaceFolder}/Utils/**",
                "${workspaceFolder}"
            ],
            "defines": [
                "USE_STDPERIPH_DRIVER",
                "STM32F10X_MD"
            ],
            // 本文件两台电脑需保持完全一致，勿提交本机绝对路径！
            // compilerPath 使用环境变量 ARM_GCC_BIN（指到 xpack 的 bin 目录，含 arm-none-eabi-gcc.exe）。
            // 各电脑设置方式：
            //   Windows: setx ARM_GCC_BIN "C:/Users/<本机用户名>/.xpack-arm-gcc/xpack-arm-none-eabi-gcc-15.2.1-1.1/bin"
            // 设置后请完全重启 VSCode。
            "compilerPath": "${env:ARM_GCC_BIN}/arm-none-eabi-gcc.exe",
            "cStandard": "c99",
            "cppStandard": "c++11",
            "intelliSenseMode": "gcc-arm"
        }
    ],
    "version": 4
}